diff --git a/subsys/bluetooth/host/buf.c b/subsys/bluetooth/host/buf.c
index 56902468aae..5a5bd518794 100644
--- a/subsys/bluetooth/host/buf.c
+++ b/subsys/bluetooth/host/buf.c
@@ -35,7 +35,16 @@ LOG_MODULE_REGISTER(bt_buf, CONFIG_BT_LOG_LEVEL);
  * It's true that we don't put all kinds of events there (yet). However, the
  * command complete event has an arbitrary payload, depending on opcode.
  */
+#if defined(CONFIG_LT213A_BT_COMPACT_BUFFERS)
+/* The fixed controller has no vendor/extended events. Include Command Complete
+ * and Read Supported Commands, the largest enabled synchronous response. */
+BUILD_ASSERT(CONFIG_BT_BUF_EVT_RX_SIZE >=
+             sizeof(struct bt_hci_evt_cmd_complete) +
+             sizeof(struct bt_hci_rp_read_supported_commands));
+#define SYNC_EVT_SIZE BT_BUF_EVT_SIZE(CONFIG_BT_BUF_EVT_RX_SIZE)
+#else
 #define SYNC_EVT_SIZE (BT_BUF_RESERVE + BT_HCI_EVT_HDR_SIZE + 255)
+#endif
 
 static atomic_ptr_t buf_rx_freed_cb;
 
@@ -111,8 +120,17 @@ static void hci_rx_pool_destroy(struct net_buf *buf)
 	buf_rx_freed_notify(BT_BUF_EVT | BT_BUF_ACL_IN);
 }
 
+#if defined(CONFIG_LT213A_BT_COMPACT_BUFFERS)
+/* Keep both ACL reassembly buffers and all event slots, but do not reserve a
+ * full ATT MTU for every short HCI event. Notify both types on release as before. */
+NET_BUF_POOL_FIXED_DEFINE(acl_rx_pool, BT_BUF_ACL_RX_COUNT, BT_BUF_ACL_RX_SIZE,
+                         sizeof(struct bt_conn_rx), hci_rx_pool_destroy);
+NET_BUF_POOL_FIXED_DEFINE(evt_rx_pool, CONFIG_BT_BUF_EVT_RX_COUNT, BT_BUF_EVT_RX_SIZE,
+                         0, hci_rx_pool_destroy);
+#else
 NET_BUF_POOL_FIXED_DEFINE(hci_rx_pool, BT_BUF_RX_COUNT, BT_BUF_RX_SIZE,
 			  sizeof(struct bt_conn_rx), hci_rx_pool_destroy);
+#endif
 #endif /* CONFIG_BT_HCI_ACL_FLOW_CONTROL */
 
 struct net_buf *bt_buf_get_rx(enum bt_buf_type type, k_timeout_t timeout)
@@ -132,6 +150,8 @@ struct net_buf *bt_buf_get_rx(enum bt_buf_type type, k_timeout_t timeout)
 	} else {
 		buf = net_buf_alloc(&acl_in_pool, timeout);
 	}
+#elif defined(CONFIG_LT213A_BT_COMPACT_BUFFERS)
+	buf = net_buf_alloc(type == BT_BUF_EVT ? &evt_rx_pool : &acl_rx_pool, timeout);
 #else
 	buf = net_buf_alloc(&hci_rx_pool, timeout);
 #endif
diff --git a/subsys/bluetooth/host/conn.c b/subsys/bluetooth/host/conn.c
index 569467915c4..de2c252127b 100644
--- a/subsys/bluetooth/host/conn.c
+++ b/subsys/bluetooth/host/conn.c
@@ -108,8 +108,12 @@ static void deferred_work(struct k_work *work);
 static void notify_connected(struct bt_conn *conn);
 
 static struct bt_conn acl_conns[CONFIG_BT_MAX_CONN];
+/* ATT has its own full-MTU TX pool. With SMP, Classic and dynamic channels
+ * disabled, this fallback pool only sends LE signalling and Pairing Failed. */
+#define ACL_TX_MTU COND_CODE_1(CONFIG_LT213A_BT_COMPACT_BUFFERS, (23), \
+                              (CONFIG_BT_L2CAP_TX_MTU))
 NET_BUF_POOL_DEFINE(acl_tx_pool, CONFIG_BT_L2CAP_TX_BUF_COUNT,
-		    BT_L2CAP_BUF_SIZE(CONFIG_BT_L2CAP_TX_MTU),
+		    BT_L2CAP_BUF_SIZE(ACL_TX_MTU),
 		    CONFIG_BT_CONN_TX_USER_DATA_SIZE, NULL);
 
 #if defined(CONFIG_BT_SMP) || defined(CONFIG_BT_CLASSIC)
