mainmenu "LT213A OpenDisplay"

config LT213A_EPD_DEEP_SLEEP
    bool "Experimental panel deep sleep (0x07 A5)"
    default n
    help
      Send the UC8151 deep-sleep command after successful power-off.
      The supplied GDEW0213T5 demo only uses power-off; validate panel
      compatibility and wake-up by RESET on hardware before enabling.

source "Kconfig.zephyr"
